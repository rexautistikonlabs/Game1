<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>FieldForge</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Every permission below is asked for lazily, at the moment the staffer
	     taps the feature that needs it. Nothing is requested at launch. -->
	<key>NSCameraUsageDescription</key>
	<string>FieldForge uses the camera to photograph business signs, business cards, in-kind donations, and site visits so you can capture a record without typing.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>FieldForge records short voice notes so you can dictate what happened while you keep walking.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>FieldForge turns your voice notes into text. Transcription runs on this iPhone, so it works with no signal.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>FieldForge stamps visits with where they happened and shows nearby contacts on the map. Location is only read while the app is open.</string>
	<key>NSContactsUsageDescription</key>
	<string>FieldForge can import a contact you already have on this iPhone instead of making you retype it.</string>
	<!-- Read access is deliberately NOT declared: every photo the app reads
	     comes through PhotosPicker, which runs out of process and needs no
	     permission. This Add string is required because the share sheet offers
	     Save to Photos for a finished document. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>FieldForge can save a copy of a finished receipt or acknowledgment letter to your photo library.</string>

	<!-- Required for a CKShare invitation link to open the app rather than
	     bouncing to Safari. Without it, accepting a team invite silently fails. -->
	<key>CKSharingSupported</key>
	<true/>
	<!-- No UIBackgroundModes on purpose. Nothing in FieldForge runs in the
	     background: the outbox drains on foreground and on a reachability
	     change, and location is when-in-use only. A fundraising app has no
	     business tracking anybody with the screen off. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
